# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must NEVER be committed.
#
# Only public (anon) Supabase credentials belong in NEXT_PUBLIC_ variables.
# Everything below without that prefix is server-only and must never be exposed
# to the browser.

# --- Public (browser + server) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only -------------------------------------------------------------
# Used exclusively by lib/supabase-admin.ts, which is guarded by "server-only".
# The six tables holding personal data are closed to anon and authenticated:
# every read and write goes through this key, server-side, after a session check.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the Arena Control staff cookie. Any long random string.
# Without it, Arena Control stays closed.
ARENA_STAFF_SESSION_SECRET=

# --- Arena Control access codes (one per operational role) -------------------
# One shared code per function, not per person. A role whose code is left empty
# simply does not appear on the sign-in screen.
ARENA_STAFF_CODE_DIRECTION=
ARENA_STAFF_CODE_ACCUEIL=
ARENA_STAFF_CODE_TABLE=
ARENA_STAFF_CODE_ARBITRE=
ARENA_STAFF_CODE_BUVETTE=
